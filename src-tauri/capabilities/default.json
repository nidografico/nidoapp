{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Ventanas de la app",
    "windows": [
        "main",
        "v-*",
        "config"
    ],
    "remote": {
        "urls": [
            "https://nidografico.com/*",
            "https://*.nidografico.com/*"
        ]
    },
    "permissions": [
        "core:default",
        "opener:default",
        "allow-leer-config",
        "allow-opciones",
        "allow-aplicar",
        "allow-restablecer",
        "allow-abrir-config",
        "allow-cerrar-config",
        "allow-recargar",
        "allow-ir-inicio",
        "allow-abrir-descargas",
        "allow-imprimir",
        "allow-abrir-enlace"
    ]
}