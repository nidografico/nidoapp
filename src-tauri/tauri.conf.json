{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "NidoApp",
    "version": "1.0.9",
    "identifier": "com.nidografico.app",
    "build": {
        "frontendDist": "../ui"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "signingIdentity": "-"
        },
        "windows": {
            "nsis": {
                "installMode": "currentUser"
            }
        }
    }
}